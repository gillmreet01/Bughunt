PORT=3000
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
# Optional local-only DNS override for SRV lookup. Leave blank to use system DNS.
MONGODB_DNS_SERVERS=
CLIENT_ORIGIN=http://localhost:3000
TZ=Asia/Kolkata
# Set to the number of reverse proxies in front of the app (so rate limits use the real client IP).
TRUST_PROXY=
